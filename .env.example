# ============ LOCAL OPTIONS (FREE, NO API KEY) ============

# LM Studio - for chat/completion
# Start LM Studio, load a model, enable the server
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Local embeddings - uses HuggingFace sentence-transformers
# Automatically enabled when LMSTUDIO_BASE_URL is set
USE_LOCAL_EMBEDDINGS=true

# ============ CLOUD OPTIONS (NEED API KEYS) ============

# OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ============ SERVER OPTIONS ============

RAG_SERVER_HOST=0.0.0.0
RAG_SERVER_PORT=8080

# Show retrieved chunks in console (true/false)
DEBUG_CHUNKS=true

# Similarity threshold for RAG retrieval (0.0-1.0)
SIMILARITY_THRESHOLD=0.4

# Number of chunks to retrieve per query
RETRIEVAL_K=5

# ============ PDF PROCESSING / OCR ============

USE_ADOBE_OCR=true
PDF_SERVICES_CLIENT_ID=your_client_id_here
PDF_SERVICES_CLIENT_SECRET=your_client_secret_here

# ============ VISION / FIGURE PROCESSING ============

# Vision at ingestion: send figures to Gemini Vision during PDF upload
# Default false = uses spatial synthesis (zero API calls, no 429 errors)
ENABLE_VISION_INGESTION=false

# Gemini model used for Vision API calls (ingestion + lazy query-time)
VISION_MODEL_NAME=gemini-2.5-flash