# Configure one of the following (LM Studio takes priority if set):

# ============ LOCAL OPTIONS (FREE, NO API KEY) ============

# LM Studio - for chat/completion
# Start LM Studio, load a model, enable the server
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Local embeddings - uses HuggingFace sentence-transformers
# Automatically enabled when LMSTUDIO_BASE_URL is set
# Or set this to true to use local embeddings with cloud LLMs
USE_LOCAL_EMBEDDINGS=true

# ============ CLOUD OPTIONS (NEED API KEYS) ============

OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ============ SERVER OPTIONS ============

# Web server host and port
RAG_SERVER_HOST=0.0.0.0
RAG_SERVER_PORT=8080

# Show retrieved chunks in console (true/false)
DEBUG_CHUNKS=true

# Similarity threshold for RAG retrieval (0.0-1.0)
# Lower = more results (may include irrelevant), Higher = fewer results (more strict)
# Recommended: 0.3-0.5 depending on your documents
SIMILARITY_THRESHOLD=0.4

# PDF Processing - Use advanced OCR (Marker) for complex PDFs
# Set to false for faster ingestion with standard extraction only (recommended for development)
# Set to true for better table/equation handling (slower, ~1 min per page on CPU)
USE_ADVANCED_OCR=false